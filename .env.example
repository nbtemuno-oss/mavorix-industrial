# MAVORIX INDUSTRIAL environment variables
#
# Copy this file to .env.local only when an integration requires local secrets.
# Do not put real secret values in this file.

# Optional. Reserved for future AI-assisted SEO/content generation.
# Source: OpenAI dashboard, if the workflow is later changed to call the OpenAI API.
# Current deterministic scripts do not require this value.
OPENAI_API_KEY=

# Optional. Public display email for future frontend configuration.
# Current public email is configured in data/site.ts.
NEXT_PUBLIC_CONTACT_EMAIL=michael@mavorixindustrial.com

# Optional. Private notification recipient for a future real contact form provider
# or SMTP/API route. Do not expose this value through NEXT_PUBLIC_* variables.
# Current contact page uses mailto and does not send backend notifications.
CONTACT_FORM_NOTIFY_EMAIL=mavorixindustrial@163.com

# Optional. Reserved for future public configuration if needed.
# Source: Vercel Environment Variables.
# Do not place private secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_SITE_URL=
